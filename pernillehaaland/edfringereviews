        h1 { font-size: 2.25rem; font-weight: 800; margin: 12px 0 8px 0; }
        .show-meta { color: var(--text-muted); font-size: 1rem; text-transform: uppercase; font-weight: 600; }
        .badge { background: rgba(6,182,212,0.1); color: var(--cyan); padding: 4px 12px; border-radius: 9999px; font-size: 0.85rem; font-weight: 700; display: inline-block; margin-top: 12px; }
        .card { background-color: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; padding: 24px; margin-bottom: 20px; box-shadow: 0 4px 6px rgba(0,0,0,0.2); }
        .card-header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--border); padding-bottom: 14px; margin-bottom: 16px; }
